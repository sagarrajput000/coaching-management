{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coaching-center",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-29",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // Local development bindings. Freebuff Sites attaches the real DB binding on
  // deploy (sites_add_storage), and injects the FREEBUFF_* vars.
  "d1_databases": [
    { "binding": "DB", "database_name": "coaching-center", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "observability": { "enabled": true }
}
